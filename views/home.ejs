

<%- include ('partials/header.ejs')%>
    <main class="py-5">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <div class="card">
                <div class="card-header card-title">
                  <div class="d-flex align-items-center">
                    <h2 class="mb-0">All Contacts</h2>
                    <div class="ml-auto">
                      <a href="/add-contact" class="btn btn-success"><i class="fa fa-plus-circle"></i> Add New</a>
                    </div>
                  </div>
                </div>
              <div class="card-body">
                <table class="table table-hover table-striped">
                  <thead>
                    <tr>
                      <th scope="col">#</th>
                      <th scope="col">First Name</th>
                      <th scope="col">Last Name</th>
                      <th scope="col">Email</th>
                      <th scope="col">Phone</th>
                      <th scope="col">Actions</th>
                    </tr>
                  </thead>
                  <% var i = 1; %>
                  <tbody>
                    <% contacts.forEach(contact=> { %>
 <tr>
                      <td><%=  i++%></td>
                      <td><%= contact.FirstName %></td>
                      <td> <%= contact.LastName %></td>
                      <td><%= contact.email %></td>
                      <td><%= contact.phone %></td>
                   
                      <td width="150">
                         <a href="/show-contact/<%= contact.id %>"  class="btn-outline-info btn btn-sm btn-circle" title="Show"><i class="fa fa-eye"></i></a>
                        <a href="/update-contact/<%= contact.id %>"  class="btn-outline-secondary btn btn-sm btn-circle" title="Edit"><i class="fa fa-edit"></i></a>
                        <a href="/delete-contact<%= contact.id %>" class="btn-outline-danger btn btn-sm btn-circle" title="Delete" onclick="confirm('Are you sure?')"><i class="fa fa-times"></i></a>
                      </td>
                    </tr>

                 <%  });%>
                   
                  </tbody>
                </table> 
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <%- include ('partials/footer.ejs')%>
  