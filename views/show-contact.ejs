<%- include ('partials/header.ejs')%>
    <!-- content -->
    <main class="py-5">
      <div class="container">
        <div class="justify-content-md-center row">
          <div class="col-md-8">
            <div class="card">
              <div class="card-header card-title">
                <strong>Contact Details</strong>
              </div>           
              <div class="card-body">
                <div class="row">
                  <div class="col-md-12">
                    <div class="form-group row">
                      <label for="first_name" class="col-md-3 col-form-label">First Name</label>
                      <div class="col-md-9">
                        <p class="text-muted form-control-plaintext"><%= contact.FirstName%></p>
                      </div>
                    </div>

                    <div class="form-group row">
                      <label for="last_name" class="col-md-3 col-form-label">Last Name</label>
                      <div class="col-md-9">
                        <p class="text-muted form-control-plaintext"><%= contact.LastName%></p>
                      </div>
                    </div>

                    <div class="form-group row">
                      <label for="email" class="col-md-3 col-form-label">Email</label>
                      <div class="col-md-9">
                        <p class="text-muted form-control-plaintext"><%= contact.email%></p>
                      </div>
                    </div>

                    <div class="form-group row">
                      <label for="phone" class="col-md-3 col-form-label">Phone</label>
                      <div class="col-md-9">
                        <p class="text-muted form-control-plaintext"><%= contact.phone%></p>
                      </div>
                    </div>

                    <div class="form-group row">
                      <label for="name" class="col-md-3 col-form-label">Address</label>
                      <div class="col-md-9">
                        <p class="text-muted form-control-plaintext"><%= contact.address%></p>
                      </div>
                    </div>
                    <hr>
                    <div class="form-group mb-0 row">
                      <div class="col-md-9 offset-md-3">
                          <a href="/update-contact/<%= contact.id %>" class="btn btn-info">Edit</a>
                          <a href="/delete-contact/<%= contact.id %>" class="btn-outline-danger btn">Delete</a>
                          <a href="/" class="btn-outline-secondary btn">Cancel</a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
   <%- include ('partials/footer.ejs')%>